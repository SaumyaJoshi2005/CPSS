entrypoint = "modeling/deployment/__main__.py"
modules = ["python-3.11", "web"]
run = [".venv/bin/python", "-m", "modeling.deployment", "serve"]

[deployment]
deploymentTarget = "cloudrun"
build = ["bash", "-c", "python3.12 -m venv .venv && .venv/bin/python -m modeling.deployment prepare"]
run = [".venv/bin/python", "-m", "modeling.deployment", "serve"]

[env]
CPSS_MODE = "deployment"
CPSS_PORT = "8080"
CPSS_RUNTIME_DIR = "runtime"
CPSS_FRAME_ORIGINS = "https://replit.com"
CPSS_BUNDLE_URL = "https://github.com/SaumyaJoshi2005/CPSS/releases/download/v1.0.0-demo/bundle-facf415e48fc9777c9ae.zip"
CPSS_BUNDLE_SHA256 = "cfdad1c91a1f81e23916862466593952d76db7ec61ed7d4e1e8e0b2e84fc9258"

[[ports]]
localPort = 8080
externalPort = 80

[packager.features]
guessImports = false
enabledForHosting = false

[nix]
channel = "stable-25_05"
packages = ["python312"]
