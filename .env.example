CPSS_MONGODB_URI=mongodb://127.0.0.1:27017/
CPSS_DATABASE=cpss
CPSS_CACHE_DIR=.cache
CPSS_API_INTERVAL=2.2
CPSS_PAGE_INTERVAL=5.0
CPSS_GRIDFS_THRESHOLD=8388608
# Live page collection also requires the explicit --allow-pages CLI flag.
# Never place passwords, API keys, or token.txt in the repository.

