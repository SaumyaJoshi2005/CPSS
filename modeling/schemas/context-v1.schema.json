{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpss.local/schemas/context-v1",
  "oneOf": [{"$ref": "#/$defs/problem"}, {"$ref": "#/$defs/query"}],
  "$defs": {
    "texts": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 3000}},
    "evidence": {"type": "object", "additionalProperties": false,
      "required": ["source_kind", "version_id", "locator", "quote"],
      "properties": {"source_kind": {"enum": ["statement", "editorial"]},
        "version_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "locator": {"type": "string", "minLength": 1}, "quote": {"type": "string", "minLength": 1, "maxLength": 1500}}},
    "evidences": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/evidence"}},
    "review": {"type": "object", "additionalProperties": false,
      "required": ["decision", "reviewer", "reviewed_at"],
      "properties": {"decision": {"enum": ["pending", "approved", "rejected"]},
        "reviewer": {"type": ["string", "null"]}, "reviewed_at": {"type": ["string", "null"], "format": "date-time"}},
      "if": {"properties": {"decision": {"enum": ["approved", "rejected"]}}},
      "then": {"properties": {"reviewer": {"type": "string", "minLength": 1}, "reviewed_at": {"type": "string", "minLength": 1}}}},
    "provenance": {"type": "object", "additionalProperties": false,
      "required": ["kind", "source_manifest_sha256", "generation_method", "model_revision", "prompt_version"],
      "properties": {"kind": {"enum": ["corpus", "query", "illustrative"]},
        "source_manifest_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "generation_method": {"enum": ["pending", "model", "manual_draft", "illustrative"]},
        "model_revision": {"type": ["string", "null"]}, "prompt_version": {"type": ["string", "null"]}},
      "if": {"properties": {"generation_method": {"const": "model"}}},
      "then": {"properties": {"model_revision": {"type": "string", "minLength": 1}, "prompt_version": {"type": "string", "minLength": 1}}}},
    "problem": {"type": "object", "additionalProperties": false,
      "required": ["schema_version", "problem_id", "taxonomy_version", "status", "abstract_objective", "structures", "operations", "supported_approaches", "key_observations", "applicability_conditions", "unknowns", "provenance", "review"],
      "properties": {"schema_version": {"const": "problem-context-v1"}, "problem_id": {"type": "string", "minLength": 1},
        "taxonomy_version": {"type": "string", "minLength": 1},
        "status": {"enum": ["pending_generation", "draft", "human_reviewed", "rejected"]},
        "abstract_objective": {"type": ["string", "null"], "minLength": 1},
        "structures": {"$ref": "#/$defs/texts"}, "operations": {"$ref": "#/$defs/texts"},
        "supported_approaches": {"type": "array", "maxItems": 128, "items": {"type": "object", "additionalProperties": false,
          "required": ["algorithm_id", "status", "evidence", "applicability_conditions"],
          "properties": {"algorithm_id": {"type": "string", "minLength": 1}, "status": {"enum": ["candidate", "supported", "unknown"]},
            "evidence": {"$ref": "#/$defs/evidences"}, "applicability_conditions": {"$ref": "#/$defs/texts"}},
          "if": {"properties": {"status": {"const": "supported"}}}, "then": {"properties": {"evidence": {"minItems": 1}}}}},
        "key_observations": {"type": "array", "maxItems": 128, "items": {"type": "object", "additionalProperties": false,
          "required": ["text", "evidence"], "properties": {"text": {"type": "string", "minLength": 1}, "evidence": {"$ref": "#/$defs/evidences", "minItems": 1}}}},
        "applicability_conditions": {"$ref": "#/$defs/texts"}, "unknowns": {"$ref": "#/$defs/texts"},
        "provenance": {"$ref": "#/$defs/provenance"}, "review": {"$ref": "#/$defs/review"}},
      "allOf": [{"if": {"properties": {"status": {"const": "pending_generation"}}},
        "then": {"properties": {"abstract_objective": {"type": "null"}, "supported_approaches": {"maxItems": 0}, "key_observations": {"maxItems": 0}}},
        "else": {"properties": {"abstract_objective": {"type": "string", "minLength": 1}}}}]},
    "query": {"type": "object", "additionalProperties": false,
      "required": ["schema_version", "taxonomy_version", "status", "original_text", "explicit_requirements", "inferred_approaches", "exclusions", "unknowns", "provenance", "review"],
      "properties": {"schema_version": {"const": "query-context-v1"}, "taxonomy_version": {"type": "string", "minLength": 1},
        "status": {"enum": ["draft", "human_reviewed", "rejected"]}, "original_text": {"type": "string", "minLength": 1},
        "explicit_requirements": {"$ref": "#/$defs/texts"},
        "inferred_approaches": {"type": "array", "maxItems": 128, "items": {"type": "object", "additionalProperties": false,
          "required": ["algorithm_id", "rationale", "evidence_spans", "certainty"],
          "properties": {"algorithm_id": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1},
            "evidence_spans": {"$ref": "#/$defs/texts", "minItems": 1}, "certainty": {"enum": ["explicit", "inferred"]}}}},
        "exclusions": {"$ref": "#/$defs/texts"}, "unknowns": {"$ref": "#/$defs/texts"},
        "provenance": {"$ref": "#/$defs/provenance"}, "review": {"$ref": "#/$defs/review"}}}
  }
}
