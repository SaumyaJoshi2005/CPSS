# Set these in Replit Secrets/environment, not in committed .replit values.
# Preview and published origins differ: use the exact one being tested.
CPSS_MODE=deployment
CPSS_PORT=8080
CPSS_PUBLIC_ORIGIN=https://your-actual-preview-or-published-host
CPSS_RUNTIME_DIR=runtime
CPSS_INIT_TIMEOUT=120
CPSS_FRAME_ORIGINS=https://replit.com
# Optional BUILD-TIME retrieval; otherwise upload/unpack the archive manually.
# CPSS_BUNDLE_URL=https://github.com/OWNER/REPOSITORY/releases/download/TAG/bundle-HASH.zip
# CPSS_BUNDLE_SHA256=exact-64-character-sha256-from-bundle-release.json
