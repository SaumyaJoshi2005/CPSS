{
  "version": "cpss-search-v1",
  "split": "train",
  "index_path": "modeling/artifacts/search-v1",
  "evaluation_path": "modeling/artifacts/retrieval-evaluation-v1",
  "benchmark_path": "modeling/config/retrieval-queries-v1.json",
  "encoder_plan": "modeling/config/experiment-v2.json",
  "classifier_run": "modeling/artifacts/baseline-v1",
  "views": ["statement", "editorial"],
  "candidate_limit": 100,
  "result_limit": 10,
  "rrf_k": 60,
  "explicit_tag_boost": 0.15,
  "classifier_boost": 0.05,
  "default_tag_boost": false,
  "default_classifier_boost": false,
  "maximum_query_characters": 3000,
  "bm25": {"k1": 1.5, "b": 0.75, "minimum_token_length": 2,
    "stopwords": ["a", "an", "the", "of", "to", "and", "or", "in", "on", "for", "is", "are", "be", "as", "by", "with", "that", "this", "it", "you", "your", "given", "find", "each", "can", "will", "from"]},
  "query_aliases": {"union find": "dsu", "union-find": "dsu", "disjoint set union": "dsu", "disjoint sets": "dsu", "dynamic programming": "dp", "breadth first search": "dfs and similar", "breadth-first search": "dfs and similar", "bfs": "dfs and similar", "depth first search": "dfs and similar", "depth-first search": "dfs and similar", "dfs": "dfs and similar", "two pointers": "two pointers", "segment tree": "data structures", "fenwick tree": "data structures", "binary indexed tree": "data structures", "sorting": "sortings", "maximum flow": "flows", "max flow": "flows", "2 sat": "2-sat", "2-sat": "2-sat"},
  "query_fine_names": {"dijkstra": {"algorithm_id": "algorithm:dijkstra", "tag_proxy": "shortest paths"}, "bellman-ford": {"algorithm_id": "algorithm:bellman_ford", "tag_proxy": "shortest paths"}, "kruskal": {"algorithm_id": "algorithm:kruskal", "tag_proxy": "dsu"}},
  "latency": {"warmups": 1, "repeats": 3},
  "application": {"host": "127.0.0.1", "port": 8765},
  "evaluation": {"pool_depth": 5, "seed": 42, "relevance_threshold": 2, "cutoff": 10}
}
